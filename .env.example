# Hub Kouzia : modèle du fichier .env (aucune valeur ici, jamais de secret dans le dépôt).
# Dev : « make setup » crée un .env complet pour ce PC. CT Alpine : « hubctl install » le remplit.
# Droits du fichier .env : 600 (lisible par le service seulement).
# Jamais ici : le jeton du tunnel (fichier /etc/kouziahub/tunnel.token, posé par « hubctl cloudflare »).
# Variables de processus, hors .env : DEV_LAN_ORIGIN (posée par make dev-lan), API_PROXY_TARGET (proxy
# de vite), HUB_ADMIN_EMAIL et HUB_ADMIN_PASSWORD (création du compte sans terminal, recette seulement),
# API_HOST (adresse d'écoute ; vide ou absente : 127.0.0.1 en production).

# --- Base et serveur ---
NODE_ENV=
# SQLite, chemin relatif au dossier prisma/ (ex. file:../data/hub.db)
DATABASE_URL=
# Port de l'API (défaut 3101 en dev ; le CT utilise 3000)
API_PORT=
# Dossier de l'interface compilée servie par l'API (défaut : apps/web/dist). À laisser vide.
WEB_DIST=
# Dossier des fichiers des sites, versions et vignettes (défaut : data/ du dépôt)
HUB_DATA_DIR=

# --- Secrets (générés par make setup ou hubctl install) ---
# 32 octets aléatoires (openssl rand -base64 32)
SESSION_SECRET=
# 64 caractères hexadécimaux (openssl rand -hex 32)
ENCRYPTION_KEY=

# --- Origines ---
# Interface de dev (http://localhost:5174)
WEB_ORIGIN=
# Adresse publique du hub (https://hub.kouzia.com)
HUB_PUBLIC_ORIGIN=
# Cookies Secure (défaut : oui en production)
COOKIE_SECURE=
# Proxy de confiance : « true » = cloudflared sur le même CT (défaut en production)
TRUST_PROXY=

# --- Cloudflare Access devant hub.kouzia.com (obligatoire en production) ---
# Domaine de l'équipe Zero Trust (ex. monequipe.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=
# « Application Audience (AUD) Tag » de l'application Access du hub
CF_ACCESS_AUD=
# Adresse attendue dans le jeton (facultatif, contrôle en plus de la règle Access)
CF_ACCESS_EMAIL=
# « true » coupe la vérification : dev seulement, ignoré en production
CF_ACCESS_DISABLED=

# --- API Cloudflare (Pages et DNS de la zone des sous-domaines) ---
# Sans jeton, le hub fonctionne avec un Cloudflare simulé (rien n'est créé en vrai).
# Jeton créé par Alexandre : Compte > Cloudflare Pages > Edit ; Zone kouzia.com > DNS > Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Identifiant de la zone kouzia.com
CLOUDFLARE_ZONE_ID=
# Zone des sous-domaines (défaut kouzia.com)
HUB_SITES_DOMAIN=

# --- ERP (lecture seule des clients) ---
# Sans adresse, une liste de clients de démonstration est utilisée (dev).
# Adresse locale de l'ERP sur le réseau du Proxmox (ex. http://203.0.113.10:3000)
ERP_BASE_URL=
# Secret partagé avec l'ERP (32 octets aléatoires), même valeur dans le .env de l'ERP
HUB_READ_SECRET=
# Adresse de l'ERP dans le navigateur, pour le lien « Voir la fiche client » (https://erp.kouzia.com)
ERP_PUBLIC_ORIGIN=

# --- Vignettes ---
# Chemin de Chromium pour la capture (CT Alpine : /usr/bin/chromium-browser). Vide : image envoyée à la main.
HUB_CHROMIUM_PATH=

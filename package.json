{
  "name": "kouzia-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Hub Kouzia : versions de travail des sites clients sur <client>.kouzia.com (Cloudflare Pages)",
  "workspaces": [
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "prebuild": "npm run check:lockfile",
    "build": "npm run build -w @kouzia-hub/web",
    "start": "tsx --env-file=.env --tsconfig apps/api/tsconfig.json apps/api/src/index.ts",
    "typecheck": "tsc -p apps/api/tsconfig.json && tsc -b apps/web && tsc -p workers/veille/tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "admin:create": "tsx --env-file=.env --tsconfig apps/api/tsconfig.json scripts/admin-create.ts",
    "admin:2fa-reset": "tsx --env-file=.env --tsconfig apps/api/tsconfig.json scripts/admin-2fa-reset.ts",
    "test": "npm run test -w @kouzia-hub/api && npm run test -w @kouzia-hub/veille",
    "veille:build": "tsx --tsconfig workers/veille/tsconfig.json workers/veille/tools/build.ts",
    "veille:deploy": "tsx --tsconfig workers/veille/tsconfig.json scripts/veille-deploy.ts"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.41.1",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Administration (repris de l'ERP : mot de passe argon2, TOTP, codes de secours) ---

model User {
  id                         String                @id @default(cuid())
  email                      String                @unique
  name                       String?
  passwordHash               String
  /// Secret TOTP actif (base32), chiffré avec ENCRYPTION_KEY. Null = 2FA non activée.
  totpSecretEncrypted        String?
  /// Secret en cours d'enrôlement, activé après vérification d'un premier code.
  totpPendingSecretEncrypted String?
  totpEnabledAt              DateTime?
  /// Dernier pas TOTP accepté : un pas inférieur ou égal est refusé (anti-rejeu).
  totpLastStep               Int?
  /// Échecs consécutifs (mot de passe ou code) venus du tunnel, remis à zéro au succès.
  failedLogins               Int                   @default(0)
  lockedUntil                DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  sessions                   Session[]
  recoveryCodes              AdminRecoveryCode[]
  loginChallenges            AdminLoginChallenge[]
  pushSubscriptions          PushSubscription[]
}

model AdminRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Étape intermédiaire de connexion : mot de passe validé, code TOTP attendu. id = SHA-256 du jeton du cookie.
model AdminLoginChallenge {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  attempts  Int      @default(0)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Session serveur (cookie httpOnly opaque). id = SHA-256 du jeton.
model Session {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// --- Sites ---

enum SiteKind {
  /// Lié à un client de l'ERP (erpClientId renseigné).
  CLIENT
  /// Site d'Alexandre, sans client.
  PERSO
}

enum SiteState {
  /// Création en cours ou interrompue (voir la dernière opération).
  CREATING
  /// Domaine et CNAME en place : l'adresse répond.
  ONLINE
  /// CNAME et domaine retirés : l'adresse ne répond plus.
  OFFLINE
  /// Suppression en cours ou interrompue.
  DELETING
}

enum DomainStatus {
  NONE
  /// Domaine ajouté, certificat pas encore émis.
  PENDING
  ACTIVE
  ERROR
}

model Site {
  id               String       @id @default(cuid())
  /// Sous-domaine : <slug>.kouzia.com. Unique, noms réservés refusés.
  slug             String       @unique
  kind             SiteKind
  /// Identifiant du client dans l'ERP (jamais son nom ni son adresse). Null pour un site perso.
  erpClientId      String?
  /// Nom affiché. Obligatoire pour un site perso ; facultatif pour un site client (nom lu dans l'ERP).
  label            String?
  /// Hébergement de la version de travail : "pages" (Cloudflare Pages, statique) ou "php" (CT des sites PHP,
  /// docs/cadrage.md section 11). Immuable après la création.
  hosting          String       @default("pages")
  /// Projet Cloudflare Pages (kz-<slug>), unique ; null pour un site PHP (aucun projet Pages).
  pagesProject     String?      @unique
  /// Site PHP : version de PHP ("8.3"), dossier public ("public", vide = racine du projet), dossiers persistants
  /// (un par ligne, gardés d'une version à l'autre et jamais servis : "data").
  phpVersion       String?
  phpPublicDir     String?
  phpPersistentDirs String?
  /// Site PHP : sortie HTTPS permise (API de paiement en test, suivi de colis), relève IMAP (993) permise.
  phpHttpsOpen     Boolean      @default(true)
  phpImapOpen      Boolean      @default(false)
  /// Site PHP, lot P4 : variables saisies (JSON chiffré AES-GCM avec ENCRYPTION_KEY ; jamais les DB_*, remplies par
  /// l'agent) ; dossiers persistants publics (un par ligne, dans le dossier public, servis sans exécution) ; limites :
  /// envoi (1 à 128 Mo, corps 2 fois), mémoire par requête (64 à 1024 Mo), durée d'une requête (5 à 120 s).
  phpEnv           String?
  phpPublicPersistentDirs String?
  phpUploadMaxMb   Int          @default(32)
  phpMemoryLimitMb Int          @default(256)
  phpMaxExecutionSec Int        @default(30)
  /// Site PHP : chemins jamais envoyés (un par ligne ; « dossier/ » ou fichier exact, 50 au plus), refusés à l'envoi
  /// avec leur raison et retirés des fichiers de travail (fichiers lourds jamais servis : originaux, sources).
  phpExcludedPaths String?
  /// Site PHP, lot P5 : tâche planifiée (script relatif .php, fréquence 5m, 15m, 30m, 1h ou 1d ; null : aucune) ;
  /// redirection des e-mails capturés vers les adresses autorisées (une par ligne, 10 au plus), par le SMTP du hub.
  phpCronScript    String?
  phpCronEvery     String?
  phpMailRedirect  Boolean      @default(false)
  phpMailRecipients String?
  /// Adresse <projet>.pages.dev renvoyée par Cloudflare : cible du CNAME.
  pagesSubdomain   String?
  dnsRecordId      String?
  domainStatus     DomainStatus @default(NONE)
  state            SiteState    @default(CREATING)
  /// Version servie par Cloudflare (dernier déploiement réussi).
  currentVersionId String?
  /// Fichiers de la version de travail modifiés depuis la dernière publication.
  workingDirty     Boolean      @default(false)
  /// Domaine final du client (nom d'hôte seul, sans « www. »), pour la redirection d'hôte du .htaccess.
  finalDomain      String?
  /// Forme canonique sur le domaine final : "www" ou "apex".
  canonicalHost    String       @default("www")
  /// Page 404 (chemin depuis la racine du site).
  notFoundPage     String       @default("/404.html")
  /// SHA-256 du dernier .htaccess écrit par le hub : différent du fichier actuel = modifié à la main.
  serverConfigHash String?
  serverConfigAt   DateTime?
  /// Fichiers de développement servis malgré la règle (chemins exacts, un par ligne), null : aucun.
  devFilesAllowed  String?
  /// CSP du site, ajoutée à la CSP minimale de la version de travail et à celle de l'export, null : aucune.
  siteCsp          String?
  /// Indexation par les moteurs autorisée (cinquième série, 22/10/2026) : faux par défaut (noindex).
  allowIndexing    Boolean      @default(false)
  thumbnailPath    String?
  /// "capture" ou "upload".
  thumbnailSource  String?
  thumbnailAt      DateTime?
  /// Point d'intérêt du cadrage à l'affichage ("haut-gauche" à "bas-droite"), null : "haut".
  thumbnailFocus   String?
  /// Dernière activité visible (fichiers, publication, réglages) : tri « Modifiés récemment ».
  touchedAt        DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  versions         Version[]
  workingFiles     WorkingFile[]
  operations       Operation[]
  monitorTargets   MonitorTarget[]

  @@index([erpClientId])
  @@index([touchedAt])
}

/// Fichier de la version de travail (explorateur « comme un FTP »). Contenu dans le magasin d'objets
/// (data/blobs/<sha256>), partagé avec les versions publiées.
model WorkingFile {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// Chemin relatif normalisé, séparateur « / », sans « / » initial (ex. « assets/app.css »).
  path      String
  size      Int
  sha256    String
  updatedAt DateTime @updatedAt

  @@unique([siteId, path])
  @@index([sha256])
}

enum VersionStatus {
  /// Envoi vers Cloudflare en cours.
  UPLOADING
  PUBLISHED
  FAILED
  /// Déploiement supprimé chez Cloudflare et fichiers libérés (rétention).
  PURGED
}

/// Une publication : instantané des fichiers de travail, republiable.
model Version {
  id              String        @id @default(cuid())
  siteId          String
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// 1, 2, 3... par site.
  number          Int
  note            String?
  /// "files" (explorateur), "zip", "placeholder" (page d'attente de la création), "republish".
  source          String
  /// Version d'origine d'une republication.
  sourceVersionId String?
  fileCount       Int
  totalBytes      Int
  status          VersionStatus @default(UPLOADING)
  cfDeploymentId  String?
  cfDeploymentUrl String?
  error           String?
  createdAt       DateTime      @default(now())
  publishedAt     DateTime?
  purgedAt        DateTime?
  files           VersionFile[]

  @@unique([siteId, number])
  @@index([siteId, createdAt])
}

model VersionFile {
  id        String  @id @default(cuid())
  versionId String
  version   Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
  path      String
  size      Int
  sha256    String

  @@unique([versionId, path])
  @@index([sha256])
}

enum OperationKind {
  CREATE
  ENABLE
  DISABLE
  DELETE
  PUBLISH
}

enum OperationStatus {
  RUNNING
  FAILED
  DONE
}

/// Opération à étapes rejouables (création, on/off, suppression, publication). Une seule en cours par site.
model Operation {
  id         String          @id @default(cuid())
  /// Null après la suppression du site (l'historique reste lisible par slug).
  siteId     String?
  site       Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteSlug   String
  kind       OperationKind
  status     OperationStatus @default(RUNNING)
  /// JSON : [{ key, label, status: "todo"|"running"|"done"|"failed"|"waiting", detail? }]
  steps      String
  /// Paramètres de l'opération (ex. { versionId }), JSON.
  params     String?
  error      String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  @@index([siteId, startedAt])
  @@index([status])
}

/// Journal des actions (sans secret ni donnée personnelle).
model AuditEvent {
  id       String   @id @default(cuid())
  siteId   String?
  siteSlug String?
  /// ex. site.create, site.enable, site.disable, site.delete, files.upload, files.delete, files.zip,
  /// version.publish, version.republish, thumbnail.upload, orphan.delete, auth.login
  action   String
  /// "ok" ou "error".
  result   String
  detail   String?
  at       DateTime @default(now())

  @@index([siteId, at])
  @@index([at])
}

/// Résultat du dernier contrôle des orphelins (quotidien ou à la demande).
model OrphanCheck {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())
  /// "real" ou "fake" (adaptateur Cloudflare utilisé).
  mode      String
  /// JSON : [{ type: "dns"|"project"|"site", name, detail }]
  findings  String
  error     String?
}

// --- Surveillance des sites (cadrage section 10) ---

/** Abonnement Web Push d'un appareil (repris de l'ERP). */
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  label         String
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?

  @@index([userId])
}

/** Adresse surveillée : version de travail ou domaine final d'un site, zone Cloudflare, domaine manuel. */
model MonitorTarget {
  id             String            @id @default(cuid())
  siteId         String?
  site           Site?             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// Cible d'un site : "working" (<slug>.kouzia.com) ou "final" (domaine final du profil).
  siteRole       String?
  label          String
  url            String
  hostname       String
  /// "site", "cloudflare" ou "manual".
  source         String
  erpClientId    String?
  enabled        Boolean           @default(true)
  keyword        String?
  /// Référence DNS acceptée par Alexandre (JSON : A, AAAA, CNAME, NS, MX).
  dnsReference   String?
  dnsReferenceAt DateTime?
  /// Empreinte du HTML normalisé de l'accueil (référence du contrôle de contenu).
  contentHash    String?
  contentHashAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  checks         MonitorCheck[]
  hourly         MonitorHourly[]
  incidents      MonitorIncident[]
  reports        MonitorReport[]

  @@index([siteId])
  @@index([hostname])
}

/** Contrôle brut : HTTP gardé 7 jours, les autres 13 mois. */
model MonitorCheck {
  id       String        @id @default(cuid())
  targetId String
  target   MonitorTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  /// "http", "tls", "domain", "dns", "content", "speed".
  kind     String
  /// "hub" ou "edge".
  observer String
  at       DateTime
  ok       Boolean
  status   Int?
  ms       Int?
  /// JSON sans secret ni donnée personnelle.
  detail   String?

  @@index([targetId, kind, at])
  @@index([kind, at])
}

/** Agrégat horaire des contrôles HTTP, par point de contrôle (13 mois). */
model MonitorHourly {
  id       String        @id @default(cuid())
  targetId String
  target   MonitorTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  hour     DateTime
  observer String
  checks   Int
  failures Int
  avgMs    Int?
  p95Ms    Int?

  @@unique([targetId, hour, observer])
  @@index([hour])
}

/** Panne au sens de la règle de décision (les deux points, ou un seul si l'autre est muet). */
model MonitorIncident {
  id                  String        @id @default(cuid())
  targetId            String
  target              MonitorTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  startedAt           DateTime
  endedAt             DateTime?
  cause               String?
  /// Points de contrôle de la décision, séparés par une virgule ("hub,edge").
  observers           String
  notifiedAt          DateTime?
  recoveredNotifiedAt DateTime?
  reminderAt          DateTime?

  @@index([targetId, startedAt])
  @@index([endedAt])
}

/** Notification non urgente déjà envoyée (déduplication : seuils, écart DNS, contenu). */
model MonitorAlert {
  id       String   @id @default(cuid())
  targetId String?
  kind     String
  dedupKey String   @unique
  sentAt   DateTime @default(now())

  @@index([targetId])
}

/** Rapport mensuel PDF d'une cible. */
model MonitorReport {
  id        String        @id @default(cuid())
  targetId  String
  target    MonitorTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  /// "AAAA-MM".
  month     String
  path      String
  createdAt DateTime      @default(now())

  @@unique([targetId, month])
}

/** Réglages du hub en clé-valeur (ex. coordonnées du pied de page des rapports : report.email). */
model HubSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Logiciel dont le hub émet les licences (docs/licences-logiciels.md, section 5). Tracebay créé au démarrage, les
/// autres par « Nouveau logiciel ».
model Software {
  id            String    @id @default(cuid())
  /// "tracebay". Unique, immuable : URL, champ signé « logiciel » et fichier de clé privée <slug>-ed25519.pem.
  slug          String    @unique
  name          String
  /// "TB1" (Tracebay seul) ou "KZ1" (format générique). Décide du signeur. Immuable.
  format        String
  /// Préfixe de la clé : "TB1" pour Tracebay, choisi à la création sinon. Unique, immuable.
  keyPrefix     String?   @unique
  description   String?
  /// Démo ou site du logiciel (https).
  demoUrl       String?
  /// Page des versions publiées (https), facultative.
  releasesUrl   String?
  /// Vignette envoyée (WebP à son ratio, 960 px au plus), relative au dossier de données.
  thumbnailPath  String?
  thumbnailAt    DateTime?
  /// Cadrage à l'affichage : "logo" (entier, fond neutre), "logo-couleur" (fond thumbnailColor) ou "capture"
  /// (remplit le cadre). Null avec une image : envoyée avant ce réglage, déjà recadrée en 640 x 400.
  thumbnailFit   String?
  /// Couleur dominante de l'image, assombrie (#rrggbb), calculée à l'envoi.
  thumbnailColor String?
  createdAt     DateTime  @default(now())
  licenses      License[]
}

/// Clé de licence émise (registre). Entreprise et dates signées : immuables. Pas de révocation (vérification hors ligne).
model License {
  id               String   @id @default(cuid())
  softwareId       String
  software         Software @relation(fields: [softwareId], references: [id])
  /// Nom signé, NFC, 1 à 120 caractères. Immuable.
  entreprise       String
  /// Identifiant ERP, même règle que Site.erpClientId. Null si le nom a été saisi librement.
  erpClientId      String?
  /// Chiffré avec encrypt() (AES-256-GCM, ENCRYPTION_KEY). Null si vide.
  contactEncrypted String?
  /// Chaîne TB1 complète, chiffrée de la même façon. Jamais en clair dans la base.
  keyEncrypted     String
  /// AAAA-MM-JJ, heure de Paris. Immuables.
  emise            String
  expire           String
  notes            String?
  createdAt        DateTime @default(now())

  @@index([softwareId, expire])
  @@index([erpClientId])
}
